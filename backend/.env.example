# Supabase credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Cron secret for /api/scrape/run endpoint
CRON_SECRET=your_secret_token_here

# Frontend URL (for CORS). In production set to your Vercel URL e.g. https://your-frontend.vercel.app or *
FRONTEND_URL=http://localhost:5173

# Server port (Render and other cloud platforms provide this automatically via process.env.PORT)
PORT=3001

# SendGrid Email Alerts (optional: if omitted, alerts are safely logged to server console)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
