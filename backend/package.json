{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for INE Product Price Tracker — scraper, API, cron endpoint",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "scrape:test": "node src/scraper/cli.js",
    "scrape:headed": "node src/scraper/cli.js --headed",
    "scrape:all": "node src/scraper/cli.js --all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "playwright": "^1.47.0"
  }
}
